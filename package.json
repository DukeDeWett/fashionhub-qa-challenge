{
  "name": "fashionhub-qa",
  "version": "1.0.0",
  "description": "Cross-browser, multi-environment Playwright/TypeScript automation suite for FashionHub",
  "main": "index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "playwright test",
    "test:local": "playwright test --env=local",
    "test:staging": "playwright test --env=staging",
    "test:production": "playwright test --env=production",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
